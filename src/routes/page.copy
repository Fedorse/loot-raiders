<script lang="ts">
	import LootItem from '$lib/components/loot-item.svelte';

	import item from '$lib/assets/loot_assets/ARC Motion Core.png';
	import item1 from '$lib/assets/loot_assets/Blue Gate Communication Tower Key.png';
	import item2 from '$lib/assets/loot_assets/Blue Gate Cellar Key.png';
	import item3 from '$lib/assets/loot_assets/Industrial Charger.png';
	import equipmentImg from '$lib/assets/looting-bag.png';
	import weaponImg from '$lib/assets/weapon-kettle.webp';

	import { dndzone } from 'svelte-dnd-action';
	import { flip } from 'svelte/animate';

	const BACKPACK_SIZE = 20;
	const MAX_WEAPON_SLOTS = 2;

	let equipments = $state([
		{ type: 'equipment', id: 'eq-1', image: equipmentImg, count: 1, rare: 'epic' },
		{ type: 'placeholder', id: 'eq-2', image: '' }
	]);

	let backpackSlots = $state(Array.from({ length: BACKPACK_SIZE }, () => []));

	let weaponSlots = $state([[], []]);

	$effect.root(() => {
		backpackSlots[0] = [{ type: 'loot', id: 'l-1', image: item, count: 50, rare: 'common' }];
		backpackSlots[1] = [{ type: 'loot', id: 'l-2', image: item1, count: 3, rare: 'uncommon' }];
		backpackSlots[2] = [{ type: 'loot', id: 'l-3', image: item2, count: 1, rare: 'epic' }];
	});

	const flipDurationMs = 50;

	function handleBackpackConsider(targetSlotIndex, e) {
		console.log(e.detail.items);
		backpackSlots[targetSlotIndex] = e.detail.items;
	}
	function handleBackpackFinalize(targetSlotIndex, e) {
		const incoming = e.detail.items;
		backpackSlots[targetSlotIndex] = incoming;
	}

	const handleWeaponSlotConsider = (index, e) => {
		const incoming = e.detail.items;
		weaponSlots[index] = incoming;
	};

	const handleWeaponSlotFinalize = (index, e) => {
		const incoming = e.detail.items;

		weaponSlots[index] = incoming;
	};

	const handleEquipConsider = (e) => {
		console.log('handleEquipConsider', e);
		equipments = e.detail.items;
	};
	const handleEquipFinalize = (e) => {
		console.log('handleEquipFinalize', e);
		equipments = e.detail.items;
	};
</script>

<div class="flex h-full w-full items-start justify-center gap-8 bg-[#0f111a] pt-10">
	<div class="flex w-[340px] flex-col gap-4">
		<!-- equipment -->
		<section
			class="grid grid-cols-2 gap-4"
			use:dndzone={{ items: equipments, flipDurationMs }}
			onconsider={handleEquipConsider}
			onfinalize={handleEquipFinalize}
		>
			{#each equipments as item (item.id)}
				<div class="aspect-video w-full" animate:flip={{ duration: flipDurationMs }}>
					<LootItem {item} className="h-full w-full" />
				</div>
			{/each}
		</section>

		<div class="flex flex-col gap-4">
			{#each weaponSlots as slotItems, index}
				<div
					class="group relative aspect-video w-full overflow-hidden rounded-xl border border-white/10 bg-[#0f1016]/50"
				>
					<div
						class="pointer-events-none absolute inset-0 z-0 flex flex-col items-center justify-center text-white/20 transition-colors group-hover:text-white/40"
					>
						<span class="font-mono text-sm tracking-widest uppercase">Weapon Slot {index + 1}</span>
					</div>

					<section
						class="absolute inset-0 z-10 h-full w-full"
						use:dndzone={{
							items: slotItems,
							flipDurationMs,
							dropTargetStyle: { outline: 'none' },
							type: 'weapon'
						}}
						onconsider={(e) => handleWeaponSlotConsider(index, e)}
						onfinalize={(e) => handleWeaponSlotFinalize(index, e)}
					>
						{#each slotItems as item (item.id)}
							<div class="h-full w-full" animate:flip={{ duration: flipDurationMs }}>
								<LootItem {item} className="h-full w-full shadow-xl" />
							</div>
						{/each}
					</section>
				</div>
			{/each}
		</div>
	</div>

	<div class="grid w-[400px] grid-cols-4 gap-2">
		{#each backpackSlots as slotItems, index}
			<div
				class="relative aspect-square overflow-hidden rounded-xl border border-white/10 bg-[#0f1016]/20"
			>
				<section
					class="h-full w-full"
					use:dndzone={{
						items: slotItems,
						flipDurationMs,
						dropTargetStyle: { outline: 'none' },
						type: 'backpack'
					}}
					onconsider={(e) => handleBackpackConsider(index, e)}
					onfinalize={(e) => handleBackpackFinalize(index, e)}
				>
					{#each slotItems as item (item.id)}
						<div class="h-full w-full" animate:flip={{ duration: flipDurationMs }}>
							<LootItem {item} className="h-full w-full" />
						</div>
					{/each}
				</section>
			</div>
		{/each}
	</div>
</div>
